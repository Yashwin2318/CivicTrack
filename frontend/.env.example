# Copy to .env.local (development) or .env.production (build) and fill in.
# These are public identifiers, not secrets — but never put AWS access keys here.

# Cognito (stack outputs UserPoolId and UserPoolClientId). Leave empty for local demo mode.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# API base URL without trailing slash (stack output ApiUrl).
# Local dev server (backend/tools/local_dev_server.py): http://127.0.0.1:3000
VITE_API_URL=http://127.0.0.1:3000

# Shows "Preview Citizen/Officer/Admin Portal" buttons. Only honoured by `npm run dev`;
# ignored in production builds. Must be false for production.
VITE_ENABLE_DEMO_AUTH=true
